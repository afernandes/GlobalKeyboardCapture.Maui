<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GlobalKeyboardCapture.Maui.Sample.MainPage"
    Title="Keyboard diagnostics">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="16"
            MaximumWidthRequest="900"
            HorizontalOptions="Center">

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Global Keyboard Capture"
                    FontSize="30"
                    FontAttributes="Bold" />
                <Label
                    Text="Live diagnostics for app-wide keyboard, scanner, sequence, and OS-global hotkey handling."
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
            </VerticalStackLayout>

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <Grid
                    ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="8">
                    <Label Text="Platform" FontAttributes="Bold" />
                    <Label x:Name="PlatformLabel" Grid.Column="1" />
                    <Label Grid.Row="1" Text="Capture" FontAttributes="Bold" />
                    <Label x:Name="CaptureStateLabel" Grid.Row="1" Grid.Column="1" />
                    <Label Grid.Row="2" Text="Pipeline" FontAttributes="Bold" />
                    <Label x:Name="PipelineStateLabel" Grid.Row="2" Grid.Column="1" />
                    <Label Grid.Row="3" Text="OS-global" FontAttributes="Bold" />
                    <Label x:Name="GlobalHotkeyStatusLabel" Grid.Row="3" Grid.Column="1" />
                </Grid>
            </Border>

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Live key event" FontSize="20" FontAttributes="Bold" />
                    <Label
                        x:Name="KeyPressedLabel"
                        Text="Press a physical keyboard key…"
                        FontSize="24"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="KeyMetadataLabel"
                        Text="Native metadata will appear here."
                        LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label
                            Text="Enable this page's capture scope"
                            VerticalOptions="Center" />
                        <Switch
                            x:Name="CaptureScopeSwitch"
                            Grid.Column="1"
                            IsToggled="True"
                            Toggled="OnCaptureScopeToggled" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Focus-aware suspension" FontSize="20" FontAttributes="Bold" />
                    <Label Text="Capture is suspended while this Entry has focus, so normal text input remains untouched." />
                    <Entry
                        x:Name="CaptureSuspendingEntry"
                        Placeholder="Focus here and type normally"
                        Focused="OnCaptureEntryFocused"
                        Unfocused="OnCaptureEntryUnfocused" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Keyboard-wedge scanner" FontSize="20" FontAttributes="Bold" />
                    <Label
                        x:Name="ScannedCodeLabel"
                        Text="No completed scan yet."
                        FontSize="20"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="ScanMetadataLabel"
                        Text="Profile: Retail (Enter terminator, 5–128 characters, speed validation)." />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gestures" FontSize="20" FontAttributes="Bold" />
                    <Label Text="F2 — toggle the test button" />
                    <Label Text="Ctrl+S — simulate save" />
                    <Label Text="Esc — cancel" />
                    <Label Text="Ctrl+K, Ctrl+C — short sequence, deferred for a possible longer match" />
                    <Label Text="Ctrl+K, Ctrl+C, Ctrl+D — longest overlapping sequence" />
                    <Label
                        x:Name="SequenceStatusLabel"
                        Text="No pending sequence." />
                    <Button
                        Text="Cancel pending sequence"
                        Clicked="OnCancelSequenceClicked" />
                    <Label Text="Alt+Shift+X — app-lifetime hotkey while the app is active" />
                    <Label Text="Ctrl+Alt+G — true OS-global hotkey on Windows" />
                    <Button
                        x:Name="CounterButton"
                        Text="Test button"
                        Clicked="OnCounterClicked" />
                    <Label x:Name="MessageLabel" Text="Waiting for an action…" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Diagnostic stream" FontSize="20" FontAttributes="Bold" />
                        <Button
                            Grid.Column="1"
                            Text="Clear"
                            Clicked="OnClearDiagnosticsClicked" />
                    </Grid>
                    <Label Text="Newest events first; ignored native events include the rejection reason." />
                    <CollectionView
                        x:Name="DiagnosticsList"
                        HeightRequest="260"
                        EmptyView="No diagnostic event captured yet.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label
                                    Text="{Binding .}"
                                    Padding="0,5"
                                    FontFamily="monospace"
                                    FontSize="12"
                                    LineBreakMode="WordWrap" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

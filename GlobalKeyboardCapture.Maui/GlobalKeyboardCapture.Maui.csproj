<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiVersion>10.0.100</MauiVersion>

        <!-- AOT Compatibility Settings -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <DisableTrimAnalyzer>false</DisableTrimAnalyzer>
        <OptimizationPreference>size</OptimizationPreference>
        
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<AllowUnsafeBlocks Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</AllowUnsafeBlocks>

        <CurrentVersion>2.0.0</CurrentVersion>
	</PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GlobalKeyboardCapture.Maui.Tests" />
    </ItemGroup>
    
    <!--NuGet package-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Informações Básicas -->
		<PackageId>GlobalKeyboardCapture.Maui</PackageId>
		<Product>GlobalKeyboardCapture.Maui</Product>
		<Version>$(CurrentVersion)</Version>
		<Authors>Anderson Fernandes do Nascimento</Authors>
		<Company>Anderson Fernandes do Nascimento</Company>
		
		<!-- Versão detalhada -->
		<AssemblyVersion>$(CurrentVersion).0</AssemblyVersion>
		<FileVersion>$(CurrentVersion).0</FileVersion>
		<PackageVersion>$(CurrentVersion)</PackageVersion>

		<!-- Descrições -->
		<Title>MAUI Global Keyboard Capture</Title>
		<Description>Application-wide keyboard capture for .NET MAUI with keyboard-wedge barcode scanner and hotkey support.</Description>
		<Summary>Keyboard capture, hotkeys, and barcode scanner input inside active .NET MAUI application windows.</Summary>
		<PackageReleaseNotes>2.0 adds .NET MAUI 10 support for Android, Windows, iOS, and Mac Catalyst; typed gestures; scanner profiles; scopes and suspension; diagnostics and device metadata; key-up/repeat/async/sequence handling; multi-window lifecycle support; and Windows OS-global hotkeys. See https://github.com/afernandes/GlobalKeyboardCapture.Maui/blob/main/CHANGELOG.md for details.</PackageReleaseNotes>

		<!-- Metadados -->
		<Copyright>Copyright $([System.DateTime]::Now.ToString(`yyyy`)) © Anderson Fernandes do Nascimento</Copyright>
		<PackageTags>maui;barcode;keyboard;hotkeys;input;android;windows;ios;maccatalyst</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>icon.png</PackageIcon>

		<!-- Repositório -->
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/afernandes/GlobalKeyboardCapture.Maui</RepositoryUrl>
		<PackageProjectUrl>https://github.com/afernandes/GlobalKeyboardCapture.Maui</PackageProjectUrl>

		<!-- Configurações de Build -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DeterministicSourcePaths>true</DeterministicSourcePaths>

		<!-- Configurações do Pacote -->
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<MinClientVersion>6.0.0</MinClientVersion>
		<IncludeContentInPack>true</IncludeContentInPack>

		<!-- Debug/Source Link -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<!-- Condição para Source Link em Release -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath=""/>
		<None Include="../README.md" Pack="true" PackagePath=""/>
		<None Include="../LICENSE" Pack="true" PackagePath=""/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

</Project>
